# ============================================================
# 前端 / Docker Compose 环境变量示例
# 使用方法：cp .env.example .env，然后填入真实值
# 注意：.env 已被 .gitignore 忽略，切勿提交到仓库
# ============================================================

# --- 前端（vite.config.ts 读取）---
# Gemini API Key：前端直连 Gemini 时使用
GEMINI_API_KEY=your_gemini_api_key

# 后端 API 地址（本地开发）
VITE_API_URL=http://localhost:3225/api

# 前端遥测开关：true 时关闭错误/同步状态上报
VITE_TELEMETRY_DISABLED=false

# --- Docker Compose（docker-compose.yml 读取）---
# JWT 签名密钥，生产环境务必替换为 32 位以上随机字符串
# 生成方式：openssl rand -hex 32
JWT_SECRET=change_me_to_a_random_32_char_secret

# PostgreSQL 容器初始化参数
POSTGRES_USER=aiignite
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ai_ignite_cad

# 敏感字段加密密钥（后端使用，AES-256-GCM 加密 LLM API Key）
# 生成方式：openssl rand -hex 32
ENCRYPTION_KEY=change_me_to_a_random_32_byte_key

# 后端限流配额（可选，留空使用默认值）
# 认证接口 15 分钟 20 次；AI 对话每分钟 30 次；会话读写 5 分钟 120 次
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=900000
AI_RATE_LIMIT_MAX=30
AI_RATE_LIMIT_WINDOW_MS=60000
CHAT_RATE_LIMIT_MAX=120
CHAT_RATE_LIMIT_WINDOW_MS=300000

# 注入 prompt 的历史消息字符预算，超出后按确定性摘要压缩（留空使用 24000）
AI_CONTEXT_CHAR_BUDGET=24000

# 允许的非 https 模型端点主机白名单，逗号分隔；仅在明确可信的内网端点时使用
AI_ALLOWED_ENDPOINTS=""
