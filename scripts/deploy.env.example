# 复制为 scripts/deploy.env 后填写真实值。
# scripts/deploy.env 已被 .gitignore 忽略，切勿提交（其中可能含服务器地址与口令）。

# 服务器地址（必填）
AIIGNITECAD_DEPLOY_HOST=<DEPLOY_HOST>
AIIGNITECAD_DEPLOY_USER=ubuntu
AIIGNITECAD_DEPLOY_PATH=/home/ubuntu/AIIgniteCAD

# 网关槽位：宿主端口只绑 127.0.0.1，由共享网关反代到 https://<域名>/cad/
AIIGNITECAD_FRONTEND_PORT=3220
AIIGNITECAD_DOMAIN=aiignite.com.cn
CAD_SUBPATH=/cad

# 可选：服务器只接受口令登录时填写，并在本机安装 sshpass。
# 更推荐一次性配置密钥登录：ssh-copy-id ubuntu@<DEPLOY_HOST>
AIIGNITECAD_SSH_PASS=
