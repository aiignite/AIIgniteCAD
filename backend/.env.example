# ============================================================
# 后端环境变量示例
# 使用方法：cp backend/.env.example backend/.env，然后填入真实值
# 注意：backend/.env 已被 .gitignore 忽略，切勿提交到仓库
# ============================================================

# 数据库连接（本地开发）
# Docker Compose 模式下主机名为 db：postgresql://user:pass@db:5432/ai_ignite_cad
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_ignite_cad"

# 服务端口与运行环境
PORT=3225
NODE_ENV=development

# 允许跨域的前端地址
FRONTEND_URL="http://localhost:3220"

# 结构化日志级别：debug / info / warn / error
LOG_LEVEL=info

# 限流配额（单进程内存计数；多实例部署需改用共享存储）
# 认证接口：15 分钟内最多 20 次；AI 对话：每分钟最多 30 次；会话读写：5 分钟内最多 120 次
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=900000
AI_RATE_LIMIT_MAX=30
AI_RATE_LIMIT_WINDOW_MS=60000
CHAT_RATE_LIMIT_MAX=120
CHAT_RATE_LIMIT_WINDOW_MS=300000
# 紧急关闭限流（仅用于排障，生产环境勿长期开启）
RATE_LIMIT_DISABLED=false

# 注入 prompt 的历史消息字符预算（默认 24000）；超出后按确定性摘要压缩
AI_CONTEXT_CHAR_BUDGET=24000

# 允许非 https 的模型端点主机白名单，逗号分隔（如内网 Ollama 之外的自建网关）
# 默认拒绝私网/回环以外的 http 端点，避免 SSRF；仅在明确可信的内网端点时使用
AI_ALLOWED_ENDPOINTS=""

# 指标端点 /api/metrics 的访问令牌；留空表示允许匿名读取
METRICS_TOKEN=""

# JWT 签名密钥，生产环境务必替换为 32 位以上随机字符串
# 生成方式：openssl rand -hex 32
JWT_SECRET="change_me_to_a_random_32_char_secret"

# Gemini API Key（供后端 LLM 路由使用）
GEMINI_API_KEY=""

# 敏感字段加密密钥（AES-256-GCM，用于加密数据库中的 LLM API Key）
# 必须为 32 字节：64 位 hex / Base64 / 32 字符原文任选其一
# 生成方式：openssl rand -hex 32
# 注意：该密钥一旦用于加密后不可随意变更，否则历史密文将无法解密
ENCRYPTION_KEY="change_me_to_a_random_32_byte_key"
